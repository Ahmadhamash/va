# ─── Database ────────────────────────────────────────────────────────────────
# Under docker-compose the host is overridden to "db" automatically.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_assistant_db
DB_POOL_RECYCLE_SECONDS=1800
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ai_assistant_db

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Fallback key. The admin can override it at runtime from the dashboard
# (stored in the DB) without a redeploy.
OPENAI_API_KEY=sk-replace-me

# ─── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ─── AWS S3 (For Backups or File Storage) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── Redis / task queue ──────────────────────────────────────────────────────
# Overridden to redis://:${REDIS_PASSWORD}@redis:6379/0 automatically under docker-compose.
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ─── Files ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
WEB_CONCURRENCY=4

# ─── Production Server ───────────────────────────────────────────────────────
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ─── Frontend (build arg) ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── AWS S3 (For Backups or File Storage) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── Redis / task queue ──────────────────────────────────────────────────────
# Overridden to redis://:${REDIS_PASSWORD}@redis:6379/0 automatically under docker-compose.
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ─── Files ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
WEB_CONCURRENCY=4

# ─── Production Server ───────────────────────────────────────────────────────
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ─── Frontend (build arg) ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# Meta OAuth direct connection for Facebook Messenger / Instagram
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_OAUTH_SUCCESS_URL=
AI_AUTO_REPLY_ENABLED=true
AI_HUMAN_HANDOFF_LABEL=human_handoff

# ─── Make.com ────────────────────────────────────────────────────────────────
MAKE_API_TOKEN=
MAKE_TEAM_ID=
MAKE_CONNECTION_ID=
